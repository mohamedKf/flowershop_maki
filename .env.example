# Copy this file to `.env` (without `.example`) and edit values.
# `.env` is auto-loaded on startup. In production (Railway), set these as env vars instead.

# ============================================================================
# YOUR SHOP — edit these to customise the site.
# Created automatically on first `python manage.py migrate`.
# ============================================================================
SHOP_NAME=MAKI
SHOP_SLUG=MAKI
SHOP_ADDRESS=Анапа, ул. Морская 5
SHOP_PHONE=+7 (918) 555-12-34
SHOP_EMAIL=hello@flowery.ru

# ============================================================================
# Django core
# ============================================================================
SECRET_KEY=change-me-to-something-random
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Staff signup codes — give these to your managers/workers privately.
# They use them at /signup → Сотрудник tab to create their account.
# ============================================================================
MANAGER_SIGNUP_CODE=MAKI1
WORKER_SIGNUP_CODE=MAKI2

# ============================================================================
# Encryption key for sensitive DB fields (Sberbank password, Telegram token).
# Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output below. Never change it on an existing database.
# ============================================================================
FIELD_ENCRYPTION_KEY=

# ============================================================================
# Optional: bucket storage for photos in production
# Leave blank for local file storage (dev / simple deployments)
# ============================================================================
USE_S3_STORAGE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
